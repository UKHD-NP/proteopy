[flake8]
max-line-length = 79
ignore = D200, D100, E203, W503
max-complexity = 10
show-source = True
# TODO: re-include proteopy/pl/intensities.py once its pre-existing
# legacy violations (C901 complexity, E501 docstring width, unused
# import) are cleaned up in a dedicated refactor. Excluded here to keep
# the proteoform-color fix commit scoped to the feature.
exclude = docs/,proteopy/pl/intensities.py
